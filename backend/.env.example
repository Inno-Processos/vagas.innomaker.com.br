# Configuração do BACKEND (API). Copie para backend/.env:  cp backend/.env.example backend/.env
API_PORT=3001
TZ=America/Sao_Paulo
# Endereço público (vai nos links dos e-mails e no retorno do login)
SITE_URL=https://vagas.innomaker.com.br

# Chave longa e aleatória para a sessão dos candidatos. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# ---------- E-mail (Gmail) ----------
# Sem SMTP_USER/SMTP_PASS os e-mails ficam só no Histórico do painel.
# SMTP_PASS é a "senha de app" (16 letras) da conta: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rh.innomaker@gmail.com
SMTP_PASS=
SMTP_FROM=rh.innomaker@gmail.com
EMAIL_NOME=Innomaker Recrutamento
# Para onde vão as respostas dos candidatos (deixe vazio para irem ao próprio SMTP_FROM)
EMAIL_REPLY_TO=ainnomaker@gmail.com

# ---------- Backup fora do servidor ----------
# Pasta (outro disco, NAS ou pasta sincronizada com a nuvem) que recebe todo dia uma cópia do banco
# e o espelho dos arquivos enviados. No Docker, monte o volume em docker-compose.yml.
# BACKUP_EXTERNO_DIR=/backup-externo

# ---------- Login (Authelia + LLDAP) ----------
AUTHELIA_URL=https://auth.innomaker.com.br
AUTHELIA_AUTHZ_PATH=/api/authz/auth-request
AUTHELIA_COOKIE=authelia_session
# Grupos do LLDAP que viram cada papel (separe por vírgula)
GRUPOS_RH=rh,vagas_rh
GRUPOS_GERENTE=gerente,gerentes,gestor,gestores,vagas_gerente
GRUPOS_FUNCIONARIO=funcionario,funcionarios,colaborador,colaboradores,vagas_funcionario

# ---------- Só para testar no computador ----------
# Simula um usuário logado (funciona só em http://localhost). Apague em produção.
# DEV_USUARIO_FALSO={"login":"teste","nome":"Pessoa Teste","email":"teste@innomaker.com.br","grupos":["rh"]}

# ---------- Planilha de Registros (Google Sheets) ----------
# Preenchida quando o RH aprova uma admissão. Passo a passo: docs/planilha-registros.md
# PLANILHA_REGISTROS_URL=https://script.google.com/macros/s/…/exec
# PLANILHA_REGISTROS_TOKEN=
