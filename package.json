{
  "name": "vagas-innomaker",
  "version": "2.0.0",
  "private": true,
  "description": "Vagas.Innomaker self-hosted em Node.js: backend (API) e frontend separados, como o SAC",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/iniciar.js",
    "dev": "node scripts/iniciar.js --watch",
    "start:backend": "npm --workspace backend start",
    "start:frontend": "npm --workspace frontend start",
    "backup": "npm --workspace backend run backup",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  }
}
